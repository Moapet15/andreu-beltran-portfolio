# Neon PostgreSQL pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Admin access for /admin/login
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Public contact details
NEXT_PUBLIC_CONTACT_EMAIL="hola@example.com"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/in/your-profile"
NEXT_PUBLIC_GITHUB_URL="https://github.com/your-profile"
